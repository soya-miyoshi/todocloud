{
  "name": "@todocloud/core",
  "version": "0.0.0",
  "//private": "Nothing in this repository is published to a registry: `tdo` ships as the compiled executable (scripts/build-binary.mjs) through Homebrew and the GitHub release archives. `private` is what keeps it that way — an `npm publish` run here refuses outright rather than pushing the TypeScript sources and the tests to a registry — and the manifests point at `.ts` because the workspace runs its sources directly.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soya-miyoshi/todocloud.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./task": "./src/task.ts",
    "./exit": "./src/exit.ts",
    "./id": "./src/id.ts",
    "./secret": "./src/secret.ts",
    "./providercli": "./src/providercli.ts",
    "./recur": "./src/recur.ts",
    "./store": "./src/store/store.ts",
    "./store/schema": "./src/store/schema.ts",
    "./store/historical": "./src/store/historical.ts",
    "./store/availability": "./src/store/availability.ts",
    "./store/completion": "./src/store/completion.ts",
    "./store/filter": "./src/store/filter.ts",
    "./store/version": "./src/store/version.ts",
    "./output": "./src/output/output.ts",
    "./output/task": "./src/output/task.ts",
    "./output/view": "./src/output/view.ts",
    "./taskops": "./src/taskops/taskops.ts",
    "./taskops/edit": "./src/taskops/edit.ts",
    "./taskops/select": "./src/taskops/select.ts",
    "./webapi": "./src/webapi/api.ts",
    "./webapi/http": "./src/webapi/http.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  }
}
