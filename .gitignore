# ---------------------------------------------------------------------------
# Credentials and anything shaped like them.
# Deny by shape, not by known filename. Do not add exceptions here, and never
# use `git add -f` to get around this section. See CLAUDE.md §1.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.dev.vars
.dev.vars.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ecdsa*
# ed25519 is what `ssh-keygen` produces by default now, and an SSH private
# key has no extension to deny by — so the key name itself is the shape.
# `*-key` covers the Pages deploy key of .github/workflows/pwa.yml; such a
# key belongs in ~/.ssh and in a repository secret, never in this tree.
id_ed25519*
*-key
*-key.pub
*_key
*_key.pub
*credentials*.json
*credential*.json
service-account*.json
service_account*.json
gcp-*.json
client_secret*.json
.netrc
# .npmrc holds no credential here: the root one is the Takumi Guard registry
# proxy in anonymous mode, committed on purpose. Any other .npmrc may carry an
# auth token, so they stay ignored.
**/.npmrc
!/.npmrc
*.token
*token.txt
secrets.*
*.secret
*.secrets

# User config: holds provider tokens. It lives in ~/.config/todocloud/, never
# in a repository, and is ignored here so a stray copy cannot be committed.
config.toml
config.local.*
todocloud.toml

# Local databases (your actual tasks, and anything a test left behind)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Build output
/dist/
/bin/
/tdo
/tdo.exe
*.test
coverage.out
coverage.html

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript build output and dependencies (MIGRATION.md)
node_modules/
dist/
# The compiled executables (scripts/build-binary.mjs), one directory per
# target, each named like the release archive it becomes.
dist-bin/
*.tsbuildinfo
